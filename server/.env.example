# Backend Environment Variables Example
PORT=5024
NODE_ENV=production
CLIENT_URL=https://rce.gemshine.tech
MONGO_URI=mongodb://127.0.0.1:27017/rce_website

# Cloudinary Image Hosting Configuration
# Get these 3 values from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Alternatively, you can use the single CLOUDINARY_URL string:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
